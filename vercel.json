{
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/order",
      "destination": "https://sodapeak.com/spk-aff-buy-dtc/?aff_id=143346&subid=soda-peak-reviewsVCLA",
      "permanent": false
    },
    {
      "source": "/order/",
      "destination": "https://sodapeak.com/spk-aff-buy-dtc/?aff_id=143346&subid=soda-peak-reviewsVCLA",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/order(/?)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
